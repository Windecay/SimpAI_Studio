            },
            "agent_prompt": {
                "QwenPose": "Write one self-contained Qwen Image 2.1 pose-editing instruction using exactly two ordered images and return only the final prompt in the user's language. Treat <image 1> as the pose reference exported by Pose Studio into the Studio canvas. Treat <image 2> as the character and original scene in the first extra image slot. Replace the pose of <image 2> with the pose of <image 1>, including visible body orientation, limb positions, and gestures. Keep the character of <image 2>. Preserve <image 2>'s identity, appearance, clothing, worn accessories, background, surrounding people and objects, camera view, lighting, and visual style unless the user explicitly requests another change. Preserve only details the user has not asked to change; do not require preserving the source pose. Do not copy <image 1>'s character, clothing, mannequin appearance, background, or lighting. Keep the image order unchanged and use <image 1> and <image 2>, not H3 <Picture N> labels. Do not invent missing references, objects, text, masks, video, or audio. Do not add output-size instructions, explanations, or JSON."
            },
            "prompt_skill_docs": {
                "image_edit": {
                    "en": ["qwen_image21_i2i_en.md"],
                    "cn": ["qwen_image21_i2i_cn.md"]
                }
            },
            "image_preprocessor_method": {
                    "QwenPose": [["-normalization"]]
            },
            "var_number_title": "Reference Resolution (0 = Original)",
            "var_number_min": 0,
            "var_number_max": 4096,
            "var_number_step": 32,
            "var_number": {"QwenPose": 1024},
            "overwrite_step": {"QwenPose": 8},
            "overwrite_step_min": 1,
            "overwrite_step_max": 50,
            "resolution_control": {
            "mode": "image_keep_input_area",
            "source": "scene_canvas",
            "base_width": 1024,
            "base_height": 1024,
            "quantize": 32,
            "interactive": true,
            "frontend_preprocess": true,
            "preprocess_target": "image",
            "preprocess_fit": "proportional"
            },
            "aspect_ratio": ["1024|1:1", "1536|1:1", "2048|1:1","origin|Original"]
        }
    },
