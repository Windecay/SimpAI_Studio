      "var_number4_title": "ControlNet Strength", "var_number4_min": 0, "var_number4_max": 2,
      "var_number4_step": 0.05, "var_number4": {"Basic": 0.8},
      "var_number5_title": "Region Start (s)", "var_number5_min": 0, "var_number5_max": 10000,
