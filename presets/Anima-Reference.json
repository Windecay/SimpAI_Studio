      },
      "var_number6_title": "Reference Megapixels",
      "var_number6_min": 0.25,
      "var_number6_max": 1.0,
      "var_number6_step": 0.05,
      "var_number6": {
        "Anima Reference": 1.0,
        "Anima Character Reference": 1.0
      },
