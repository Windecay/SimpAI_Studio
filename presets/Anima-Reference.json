      "prompt": {
        "Anima Reference": "",
        "Anima Character Reference": ""
      },
      "agent_prompt": {
        "Anima Reference": "Follow the Anima Reference prompt contract. Reuse Anima text-to-image's shared local Rust tag lookup: select relevant returned prompt_tag values from injected candidates, or call simpai.prompts.tags when using Agent tools. Except for fixed Anima quality/score/rating controls, never invent tags from memory, translate prose into pseudo-tags, or use unrelated artist/series matches. Express unmatched concepts as short English nltags and validate with the existing Anima checks. Describe only the desired scene, count, action, pose, expression, framing and light. The references provide appearance and style; do not recaption hair, eyes, clothes or artist unless explicitly changing them. Both slots show the same character; two distinct people need one joint reference. Preserve explicit requirements such as sleeping and closed eyes without adding conflicting expressions. Do not preserve an unwanted reference pose, add image-number tags or a SnapRef LoRA tag. Return only the final English prompt; settings remain in parameter fields.",
        "Anima Character Reference": "Follow the Anima Reference prompt contract. Reuse Anima text-to-image's shared local Rust tag lookup: select relevant returned prompt_tag values from injected candidates, or call simpai.prompts.tags when using Agent tools. Except for fixed Anima quality/score/rating controls, never invent tags from memory, translate prose into pseudo-tags, or use unrelated artist/series matches. Express unmatched concepts as short English nltags and validate with the existing Anima checks. Describe the desired scene, count, action, pose, expression, framing, light and requested style. The references provide appearance; do not recaption hair, eyes or clothes unless explicitly changing them. Both slots show the same character; two distinct people need one joint reference. Preserve explicit requirements such as sleeping and closed eyes without adding conflicting expressions. Do not preserve an unwanted reference pose, add image-number tags or a SnapRef LoRA tag. Return only the final English prompt; settings remain in parameter fields."
      },
      "image_preprocessor_method": {
        "Anima Reference": [["-normalization"], ["-normalization"]],
        "Anima Character Reference": [["-normalization"], ["-normalization"]]
      },
      "steps": {
        "Anima Reference": 28,
        "Anima Character Reference": 28
      },
      "steps_min": 1,
      "steps_max": 60,
      "var_number3_title": "Reference Image 1 Weight",
      "var_number3_min": 0.0,
      "var_number3_max": 2.0,
      "var_number3_step": 0.05,
      "var_number3": {
        "Anima Reference": 1.0,
        "Anima Character Reference": 1.0
      },
      "var_number4_title": "Reference Image 2 Weight",
      "var_number4_min": 0.0,
      "var_number4_max": 2.0,
      "var_number4_step": 0.05,
      "var_number4": {
        "Anima Reference": 1.0,
