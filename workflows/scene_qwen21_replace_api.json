  "simpai_qwen21_clothing_width": {
    "class_type": "ComfyMathExpression",
    "inputs": {
      "expression": "max(32, round(a * min(1, max(32, floor(c / 32) * 32) / max(a, b)) / 32) * 32) if c > 0 else a",
      "values.a": ["simpai_qwen21_clothing_size", 0],
      "values.b": ["simpai_qwen21_clothing_size", 1],
      "values.c": ["1", 10]
    },
    "_meta": {"title": "Clothing reference width within edge limit"}
  },
  "simpai_qwen21_clothing_height": {
    "class_type": "ComfyMathExpression",
    "inputs": {
      "expression": "max(32, round(b * min(1, max(32, floor(c / 32) * 32) / max(a, b)) / 32) * 32) if c > 0 else b",
      "values.a": ["simpai_qwen21_clothing_size", 0],
      "values.b": ["simpai_qwen21_clothing_size", 1],
      "values.c": ["1", 10]
    },
    "_meta": {"title": "Clothing reference height within edge limit"}
  },
  "simpai_qwen21_clothing_scale": {
